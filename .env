# PostgreSQL Configuration (required for database-backed message storage)
# Format: postgresql://username:password@host:port/database
# Note: Only set this if you have PostgreSQL running. The app works fine without it.
# DATABASE_URL=postgresql://voltex_app:your-password@localhost:5432/voltex_messages

# Archival Job Configuration (only applies if DATABASE_URL is set)
# How often to run the archival job (milliseconds, default: 7200000 = 2 hours)
ARCHIVAL_INTERVAL_MS=7200000

# How old messages must be before archival (milliseconds, default: 7200000 = 2 hours)
MESSAGE_AGE_MS=7200000

# Maximum messages to process per archival run (default: 1000)
ARCHIVAL_BATCH_SIZE=1000

# Automatically delete messages from PostgreSQL after R2 archival (default: true)
DELETE_AFTER_ARCHIVAL=true

# Grace period before deletion in milliseconds (default: 0 = delete immediately)
# Useful if you want to keep messages in DB briefly after archival for safety
DELETE_GRACE_MS=0

# Cloudflare R2 Configuration (for message archival and user data storage)
#secret
R2_ACCESS_KEY_ID=cdcc5e5d5e0052ec81fa61ebf1e55581
#secret
R2_SECRET_ACCESS_KEY=6de40255da692165151bbfbf0ae17100a5ccfada390f74555ba587d6ca0ca4d7
#secret
R2_ENDPOINT_URL=https://692721994bc25d00006b205c4b487e7f.r2.cloudflarestorage.com
